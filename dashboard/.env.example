# Template env var untuk Dashboard PDBK.
# Salin file ini ke .env.local dan isi dengan nilai asli.
# .env.local di-ignore oleh .gitignore sehingga tidak akan ter-commit.

# URL Apps Script Web App yang menyajikan Google Sheet sebagai JSON.
APPS_SCRIPT_URL="https://script.google.com/macros/s/<deployment-id>/exec"

# Per-tab sheet names (default: "Form Responses 1" s/d 4).
# Override hanya jika nama tab Anda berbeda dari default.
GURU_TAB="Form Responses 1"
KEPSEK_TAB="Form Responses 2"
ORTU_TAB="Form Responses 3"
SISWA_TAB="Form Responses 4"
